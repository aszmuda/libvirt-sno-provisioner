## Copy this file to config/.env.local and customize values.
## config/.env.local is ignored by git.

export BASE_DOMAIN=example.lab
export CLUSTER_NAME=sno
export OCP_USER=admin
export OCP_PASS=replace-me
export PULL_SECRET='{"auths":{}}'
export CERT_DIR=~/.acme.sh/example.lab_ecc

# Optional feature flags (true/false)
export ENABLE_IDP=true
export ENABLE_STORAGE=true
export ENABLE_IMAGE_REGISTRY=true
export ENABLE_CERTS=true
